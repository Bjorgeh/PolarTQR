<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PolarTQR.Pages.ActivatePage"
             x:DataType="ContentPage"
             Title="Aktiver konto"
             BackgroundColor="{StaticResource Ink}">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="10" MaximumWidthRequest="480">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="✉️" FontSize="24" VerticalOptions="Start" />
                    <Label Grid.Column="1" TextColor="{StaticResource Muted}" FontSize="14" LineBreakMode="WordWrap"
                           Text="Skriv inn koden fra invitasjonen på e-post og velg ditt eget passord. Har du glemt passordet, kan arrangøren sende deg en ny kode." />
                </Grid>
            </Border>

            <Label Text="E-post" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="Email" Keyboard="Email" FontSize="17" TextColor="White" PlaceholderColor="#64748B"
                       Placeholder="navn@eksempel.no" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            </Border>
            <Label Text="Invitasjonskode" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="Code" FontSize="22" FontFamily="OpenSansSemibold" Placeholder="F.eks. K7MX2QPA"
                       TextColor="{StaticResource Accent}" PlaceholderColor="#64748B" CharacterSpacing="2"
                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="12" />
            </Border>
            <Label Text="Nytt passord" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="Password" IsPassword="True" FontSize="17" TextColor="White" />
            </Border>
            <Label Text="Gjenta passord" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="Password2" IsPassword="True" FontSize="17" TextColor="White" ReturnType="Go" Completed="OnActivate" />
            </Border>
            <Label TextColor="{StaticResource Muted}" FontSize="13" Margin="4,2,0,0"
                   Text="Minst 8 tegn med stor og liten bokstav, tall og et spesialtegn (f.eks. ! eller ?)." />

            <Border x:Name="StatusBox" IsVisible="False" Style="{StaticResource Card}" Padding="14,12" Margin="0,6,0,0">
                <Label x:Name="Status" TextColor="White" FontSize="15" LineBreakMode="WordWrap" />
            </Border>

            <Button x:Name="ActivateButton" Text="Aktiver og logg inn" Clicked="OnActivate"
                    Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Accent}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
