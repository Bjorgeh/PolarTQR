<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:vm="clr-namespace:PolarTQR.ViewModels"
             x:Class="PolarTQR.Pages.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="{Binding Label}"
             BackgroundColor="{StaticResource Ink}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Bytt arrangement" Order="Secondary" Clicked="OnLeave" />
        <ToolbarItem x:Name="LogoutItem" Text="Logg ut" Order="Secondary" Clicked="OnLogout" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Arrangement og teller -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="16,8,16,12" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding EventName}" FontSize="18" FontFamily="OpenSansSemibold"
                               TextColor="White" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding EventTime}" FontSize="13" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceHigh}"
                            StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="-2">
                            <Label Text="{Binding CheckedIn}" FontSize="26" FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                            <Label Text="{Binding CounterText}" FontSize="11" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Kamera -->
            <Border Grid.Row="1" Margin="16,0" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="Black">
                <Grid>
                    <zxing:CameraBarcodeReaderView x:Name="Camera" BarcodesDetected="OnBarcodesDetected"
                                                   IsTorchOn="{Binding TorchOn}" />
                    <!-- Sikteramme med samme hjørner som appikonet -->
                    <Image Source="scan_frame.png" WidthRequest="250" HeightRequest="250" InputTransparent="True"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,18" InputTransparent="True"
                            Style="{StaticResource Pill}" BackgroundColor="#B30B1220" Padding="14,6">
                        <Label Text="Hold QR-koden inne i rammen" TextColor="White" FontSize="13" />
                    </Border>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}"
                                       HeightRequest="56" WidthRequest="56" />
                    <Label x:Name="CameraMessage" IsVisible="False" TextColor="White" FontSize="16"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="24" />
                </Grid>
            </Border>

            <!-- Knapper -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="16,14,16,20">
                <Button Grid.Column="0" Text="🔍  Søk gjest" Clicked="OnSearch" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="🔦  Lys" Command="{Binding ToggleTorchCommand}" Style="{StaticResource SecondaryButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding TorchOn}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="{StaticResource AccentInk}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="↩️  Angre" Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Grid>

        <!-- Resultat: grønn / gul / rød over hele skjermen (synlig i døra), står til vakten trykker -->
        <Grid IsVisible="{Binding OverlayVisible}" BackgroundColor="{Binding OverlayColor}" Padding="28">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissOverlayCommand}" />
            </Grid.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                <Border WidthRequest="150" HeightRequest="150" StrokeThickness="0" BackgroundColor="#33FFFFFF"
                        StrokeShape="RoundRectangle 75" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label Text="{Binding OverlayIcon}" FontSize="84" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding OverlayTitle}" FontSize="32" FontFamily="OpenSansSemibold" TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding OverlayName}" FontSize="26" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="{Binding OverlayDetail}" FontSize="17" TextColor="White" Opacity="0.9"
                       HorizontalTextAlignment="Center" />
                <Border HorizontalOptions="Center" Margin="0,36,0,0" Style="{StaticResource Pill}"
                        BackgroundColor="#33000000" Padding="18,10">
                    <Label Text="Trykk for å skanne neste" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" />
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
